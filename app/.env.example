# auto: usa KiCad si responde; si no, arranca en modo de desarrollo.
# live: exige KiCad. fake: no toca KiCad.
KICAD_MODE=auto

# Endpoint compatible con la API de chat de OpenAI.
# Gemini: https://generativelanguage.googleapis.com/v1beta/openai  con LLM_MODEL=gemini-3.5-flash-lite
# Ollama: http://127.0.0.1:11434/v1  y LLM_API_KEY puede quedar vacío.
LLM_BASE_URL=http://127.0.0.1:11434/v1
LLM_API_KEY=
LLM_MODEL=qwen2.5-coder
# Vacío desactiva la revisión. Con Gemini, un modelo más capaz revisa antes de escribir.
# LLM_REVIEW_MODEL=gemini-3.5-flash

HOST=127.0.0.1
PORT=8765

# Vacío busca kicad-cli en el PATH y en /Applications/KiCad.
KICAD_CLI=

# Cada cuántos segundos mira el servidor si KiCad cambió (estado y selección).
# WATCH_INTERVAL=1.5

# Pre-chequeo IPC (solo Clase 2 está calibrada).
# IPC_CLASS=2

# Autoruteo FreeRouting (descarga verificada al primer uso).
# FREEROUTING_DOWNLOAD=1
# FREEROUTING_TIMEOUT=300
# FREEROUTING_JAR=
# FREEROUTING_SHA256=d7fd0f63f52e6d74b0fad6715f87ca9f0ffd7109d66b2a584638000270592ecf
# JAVA_BIN=
# AUTOROUTE_ENABLED=0
# KICAD_PYTHON=/Applications/KiCad/KiCad.app/Contents/Frameworks/Python.framework/Versions/Current/bin/python3

# Preferible: configura LLM, Java y autoruteo en ⚙ Ajustes del chat
# (se guardan en ~/Library/Application Support/kicad-ia/user-settings.json).
